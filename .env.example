# Post-Quantum CA System Configuration
# Copy this file to .env and update with your values

# ========== CA Configuration ==========
# Certification Authority Settings
CA_ROOT_CN=PQI-Root-CA
CA_ICA_CN=PQI-Intermediate-CA
CA_COUNTRY=IN
CA_STATE=State
CA_LOCALITY=City
CA_ORG=Organization

# ========== Cryptography Settings ==========
# Algorithm Selection
USE_SPHINCS_PLUS=true
USE_GBS_HASHING=true
FALLBACK_TO_HMAC=true

# SPHINCS+ Parameters
SPHINCS_VARIANT=SPHINCS+-SHA2-128f-simple
SPHINCS_SECURITY_LEVEL=1

# ========== Performance Settings ==========
# Multiprocessing
NUM_WORKERS=4
USE_MULTIPROCESSING=true

# Certificate Generation
BATCH_SIZE=10
PARALLEL_SIGNING=true

# ========== Security Settings ==========
# Token Validity
TOKEN_VALIDITY_MINUTES=5
CERTIFICATE_VALIDITY_DAYS=365

# Certificate Revocation
ENABLE_CRL=true
CRL_UPDATE_INTERVAL_HOURS=24

# ========== Logging Settings ==========
LOG_LEVEL=INFO
LOG_FILE=pqi_ca.log
ENABLE_DEBUG=false

# ========== Quantum Settings ==========
# Gaussian Boson Sampling
GBS_ENABLED=true
GBS_SQUEEZING_PARAMETER=0.5
GBS_NUM_MODES=8
GBS_LOSS=0.05

# TensorFlow (suppress warnings)
TF_CPP_MIN_LOG_LEVEL=3
CUDA_VISIBLE_DEVICES=-1
TF_FORCE_GPU_ALLOW_GROWTH=false
